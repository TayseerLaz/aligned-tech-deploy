  Redirect 301 /how-ai-chatbots-are-transforming-customer-support-across-the-gulf/ https://www.aligned-tech.com/services/whatsapp-bot-building

  # — Old blog posts → IT Infrastructure service (5) —
  Redirect 301 /what-are-the-most-common-it-and-cloud-implementation-mistakes/ https://www.aligned-tech.com/services/it-infrastructure
  Redirect 301 /common-mistakes-in-it-cloud-implementation/ https://www.aligned-tech.com/services/it-infrastructure
  Redirect 301 /it-support-checklist-for-growing-companies-in-the-gulf/ https://www.aligned-tech.com/services/it-infrastructure
  Redirect 301 /top-5-signs-your-business-needs-managed-it-services/ https://www.aligned-tech.com/services/it-infrastructure
  Redirect 301 /why-mena-businesses-need-proactive-it-support-in-2025/ https://www.aligned-tech.com/services/it-infrastructure

  # — Old blog posts → Cloud Solutions service (3) —
  Redirect 301 /top-cloud-challenges-for-african-businesses-and-how-to-overcome-them/ https://www.aligned-tech.com/services/cloud-solutions
  Redirect 301 /how-scalable-cloud-hosting-drives-business-growth-in-emerging-markets/ https://www.aligned-tech.com/services/cloud-solutions
  Redirect 301 /benefits-of-moving-your-business-to-the-cloud-in-mena-africa/ https://www.aligned-tech.com/services/cloud-solutions

  # — Old blog posts → Web & Mobile Development service (3) —
  Redirect 301 /web-development-trends-for-mena-enterprises/ https://www.aligned-tech.com/services/web-mobile-development
  Redirect 301 /top-mobile-app-features-for-the-gulf-market-in-2025/ https://www.aligned-tech.com/services/web-mobile-development
  Redirect 301 /why-responsive-web-design-is-crucial-for-businesses-in-africa/ https://www.aligned-tech.com/services/web-mobile-development

  # — Old blog posts with no service match → /blogs index (12) —
  Redirect 301 /ai-smes-gulf-competition/ https://www.aligned-tech.com/blogs
  Redirect 301 /data-privacy-ai-middle-east/ https://www.aligned-tech.com/blogs
  Redirect 301 /future-ai-middle-east-trends/ https://www.aligned-tech.com/blogs
