# 2) Canonical host: force HTTPS + www so every request lands on https://www.aligned-tech.com
# This matches the <link rel="canonical"> declared on every page and stops duplicate-content
# indexing of http:// or non-www variants.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # http → https
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # non-www → www (skips the qatar subdomain which has its own canonical)
  RewriteCond %{HTTP_HOST} ^aligned-tech\.com$ [NC]
  RewriteRule ^ https://www.aligned-tech.com%{REQUEST_URI} [L,R=301]

  # Explicit pass-through for static subsites (Qatar landing page etc.)
  RewriteRule ^qatar-ai-chatbot(/.*)?$ - [L]

  # Route everything else through index.html for React Router
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 3) Gzip compression (faster loads + better SEO)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml text/xml
</IfModule>

# 4) Long-term caching for static assets (Vite filenames are hashed, so safe)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 5) Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(self), camera=()"
</IfModule>

# 6) Custom 404 falls through to SPA (handled by section 2)
ErrorDocument 404 /index.html
