# Aligned Tech — cPanel / Apache config
# Purpose: SPA routing + security headers + caching + compression

# Serve index.html when a directory is requested (fixes /qatar-ai-chatbot/)
DirectoryIndex index.html

# 1) 301 Redirects — legacy WordPress URLs → new site structure
# These old paths returned 403 after the WP→React migration; redirects preserve
# Google rankings + backlink equity. Source: AlignedTech_SEO_Tracker_v2 (Glimmers, 11 May 2026).
# mod_alias runs before mod_rewrite, so these fire before the SPA fallback below.
<IfModule mod_alias.c>
  # — Old service pages (3) —
  Redirect 301 /cloud-solutions/ https://www.aligned-tech.com/services/cloud-solutions
  Redirect 301 /web-mobile-development/ https://www.aligned-tech.com/services/web-mobile-development
  Redirect 301 /search-engine-optimization/ https://www.aligned-tech.com/services

  # — Old blog posts → AI Automation service (6) —
  Redirect 301 /automate-customer-service-ai-guide/ https://www.aligned-tech.com/services/ai-automation
  Redirect 301 /what-is-ai-business-mena/ https://www.aligned-tech.com/services/ai-automation
  Redirect 301 /ai-how-can-it-help-my-business-in-mena/ https://www.aligned-tech.com/services/ai-automation
  Redirect 301 /business-ai-automation-mena-guide/ https://www.aligned-tech.com/services/ai-automation
  Redirect 301 /how-can-businesses-use-ai-tools-to-automate-repetitive-tasks/ https://www.aligned-tech.com/services/ai-automation
  Redirect 301 /integrating-smart-tools-for-business-efficiency-in-mena/ https://www.aligned-tech.com/services/ai-automation

  # — Old blog posts → WhatsApp Bot Building service (4) —
  Redirect 301 /top-ai-whatsapp-chatbots-uae-ksa/ https://www.aligned-tech.com/services/whatsapp-bot-building
  Redirect 301 /meta-integration-review-2026-features-verdict/ https://www.aligned-tech.com/services/whatsapp-bot-building
